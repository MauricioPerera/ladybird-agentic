// https://html.spec.whatwg.org/multipage/nav-history-apis.html#location
[Exposed=Window]
interface Location { // but see also additional creation steps and overridden internal methods
    [LegacyUnforgeable, NeedsCallerRealm] stringifier attribute USVString href;
    [LegacyUnforgeable, NeedsCallerRealm] readonly attribute USVString origin;
    [LegacyUnforgeable, NeedsCallerRealm] attribute USVString protocol;
    [LegacyUnforgeable, NeedsCallerRealm] attribute USVString host;
    [LegacyUnforgeable, NeedsCallerRealm] attribute USVString hostname;
    [LegacyUnforgeable, NeedsCallerRealm] attribute USVString port;
    [LegacyUnforgeable, NeedsCallerRealm] attribute USVString pathname;
    [LegacyUnforgeable, NeedsCallerRealm] attribute USVString search;
    [LegacyUnforgeable, NeedsCallerRealm] attribute USVString hash;

    [LegacyUnforgeable, NeedsCallerRealm] undefined assign(USVString url);
    [LegacyUnforgeable, NeedsCallerRealm] undefined replace(USVString url);
    [LegacyUnforgeable] undefined reload();

    [LegacyUnforgeable, SameObject] readonly attribute DOMStringList ancestorOrigins;
};
