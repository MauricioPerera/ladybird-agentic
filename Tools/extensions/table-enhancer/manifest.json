{
  "manifest_version": 3,
  "id": "ladybird-table-enhancer",
  "name": "Table Filter & Sort Enhancer",
  "version": "1.0.0",
  "description": "Adds live search filtering, clickable multi-type column sorting, row counters, and 1-click CSV export to HTML data tables.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://mail.google.com/*",
        "https://calendar.google.com/*",
        "https://docs.google.com/*",
        "https://drive.google.com/*",
        "https://studio.youtube.com/*",
        "https://www.youtube.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://web.whatsapp.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
